<?xml version="1.0" encoding="utf-8"?>
<!--
  网络安全配置

  自建音源服务已改走 HTTPS 反代（https://mt.fbc299.xyz），但我们**不能**全局禁用明文：
  实测网易云直链 6/6 都是 http://（m*.music.126.net 等镜像域名/IP 不定），
  咪咕/酷狗的部分 CDN 同样有 http。base-config 一旦禁止明文，这些歌会直接播不出来，
  而且域名无法预先枚举成白名单（反代/镜像会变），所以这里保持明文放行。

  真正要收紧的是「我们自己的服务端」：默认地址已在代码里改成 HTTPS，
  剩下的 http 只可能来自用户手填的旧地址（设置页可改），风险自担。
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
